{
  "name": "@loot-game/stack",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter '@loot-game/*' dev",
    "dev:client": "bun run --filter @loot-game/client dev",
    "dev:server": "bun run --filter @loot-game/server dev",
    "build:client": "bun run --filter @loot-game/client build",
    "deploy": "bun run --filter @loot-game/client build && bun run --filter @loot-game/server deploy",
    "test:battle": "bun test tests/battle",
    "record:battle": "bun tests/battle/record.ts",
    "prepare:battle-models": "bun scripts/prepare-battle-models.ts",
    "typecheck": "tsc --noEmit -p apps/client && tsc --noEmit -p apps/server"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/extensions": "4.5.0",
    "@gltf-transform/functions": "4.5.0",
    "gltf-validator": "2.0.0-dev.3.10",
    "happy-dom": "20.14.0",
    "sharp": "0.35.4",
    "three": "0.186.0"
  }
}
